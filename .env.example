# Zona horaria del servidor n8n (afecta al cron y a los logs)
GENERIC_TIMEZONE=Europe/Madrid

# Zona horaria del sistema operativo del contenedor
TZ=Europe/Madrid

# Idioma de la interfaz de n8n
N8N_DEFAULT_LOCALE=es

# URL base que n8n usa para construir las URLs de los webhooks
# En local basta con localhost; en producción pon el dominio público
WEBHOOK_URL=http://localhost:5678/

# Desactiva la cookie segura (necesario en localhost sin HTTPS)
# Cambiar a true si se despliega con HTTPS en producción
N8N_SECURE_COOKIE=false
